rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Fetch the caller's role from /users/{uid} safely
    function getRole() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return isSignedIn() && getRole() in ['Admin', 'admin'];
    }

    function isSeller() {
      return isSignedIn() && getRole() in ['Seller', 'seller'];
    }

    function isBuyer() {
      return isSignedIn() && getRole() in ['Buyer', 'buyer'];
    }

    function isSellerOrAdmin() {
      return isAdmin() || isSeller();
    }

    // ─── /users/{uid} ─────────────────────────────────────────────────────
    // A user can read & manage their own profile (without escalating role/approval).
    // Admins can read, approve/reject, update, and delete any user profile.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['Buyer', 'Seller', 'buyer', 'seller']);
      allow update: if isAdmin()
        || (isOwner(uid)
            && (!('role' in request.resource.data)
                || request.resource.data.role == resource.data.role)
            && (!('verified' in request.resource.data)
                || request.resource.data.verified == resource.data.verified)
            && (!('status' in request.resource.data)
                || request.resource.data.status == resource.data.status));
      allow delete: if isAdmin();
    }

    // ─── /products/{productId} ────────────────────────────────────────────
    match /products/{productId} {
      allow read: if
        resource.data.status == 'Approved'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      allow create: if
        isSellerOrAdmin()
        && request.resource.data.sellerId == request.auth.uid
        && (isAdmin() || request.resource.data.status == 'Pending');

      allow update: if
        (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status == resource.data.status)
        || isAdmin();

      allow delete: if
        (isSeller() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
    }

    // ─── /nursery/{listingId} ─────────────────────────────────────────────
    match /nursery/{listingId} {
      allow read: if
        resource.data.status == 'Approved'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      allow create: if
        isSellerOrAdmin()
        && request.resource.data.sellerId == request.auth.uid
        && (isAdmin() || request.resource.data.status == 'Pending');

      allow update: if
        (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status == resource.data.status)
        || isAdmin();

      allow delete: if
        (isSeller() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
    }

    // ─── /tools/{listingId} ───────────────────────────────────────────────
    match /tools/{listingId} {
      allow read: if
        resource.data.status == 'Approved'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      allow create: if
        isSellerOrAdmin()
        && request.resource.data.sellerId == request.auth.uid
        && (isAdmin() || request.resource.data.status == 'Pending');

      allow update: if
        (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status == resource.data.status)
        || isAdmin();

      allow delete: if
        (isSeller() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
    }

    // ─── /orders/{orderId} ────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if
        isAdmin()
        || (isSignedIn() && resource.data.buyerId == request.auth.uid)
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || (isSignedIn() && 'sellerIds' in resource.data && request.auth.uid in resource.data.sellerIds);

      allow create: if
        isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      allow update: if
        (isSeller() && (resource.data.sellerId == request.auth.uid
          || ('sellerIds' in resource.data && request.auth.uid in resource.data.sellerIds)))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── /notifications/{notifId} ─────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if
        isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if
        isSignedIn() && request.resource.data.userId is string;
      allow update: if
        isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if
        isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── /cart/{cartId} ───────────────────────────────────────────────────
    match /cart/{cartId} {
      allow read, update, delete: if
        isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if
        isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ─── Deny all other reads/writes by default ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
